{
    "version": "0.2.0",
    "configurations": [
        {
            // Configure a default build task for 'cargo build'
            "preLaunchTask": "rust: cargo build",
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "probe_rs Server attach example",
            "server": "host.docker.internal:50001",
            "speed": 4000,
            "chip": "RP2040",
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    //!MODIFY
                    // "programBinary": "/Users/tanakaikko/Desktop/rp2040_hal_template/target/thumbv6m-none-eabi/debug/rp2040_example",
                    "programBinary": "${env:LOCAL_WORKSPACE_FOLDER}/target/thumbv6m-none-eabi/debug/rp2040_example",
                }
            ],
            //!This won't take effect. Please set environment variables before launching `probe-rs dap-server`.
            "env": {},
            // Info, Debug
            "consoleLogLevel": "Info"
        }
    ]
}